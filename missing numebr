import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[]={0,1,4,6,2,3};
        int sum=0;
        for(int i:arr)
        {
            sum=sum^i;
        }
       int n=arr.length;
       for(int i=0;i<=n;i++)
       {
           sum=sum^i;
       }
       System.out.print(sum);
    }
}
