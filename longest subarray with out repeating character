class Solution {
    public int lengthOfLongestSubstring(String s) {
        int[]  hash=new int[256];
        Arrays.fill(hash,-1);
        int n=s.length();
        int l=0;
        int r=0;
        int max=0;
        while(r<n)
        {
            char cu=s.charAt(r);
            if(hash[cu]!=-1)
            {
                if(hash[cu]>=l)
                {
                    l=hash[cu]+1;
                }
            }
            int len=r-l+1;
            max=Math.max(len,max);
            hash[cu]=r;
            r++;
        }
        return max;
    }
}
