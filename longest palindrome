class Solution {
    
    public String con(String s, int l, int r, int len) {
        while (l >= 0 && r < len && s.charAt(l) == s.charAt(r)) {
            l--;
            r++;
        }
        return s.substring(l + 1, r);
    }

    public String getLongestPal(String s) {
        int n = s.length();
        if (n == 0) return "";
        
        String ans = "";

        for (int i = 0; i < n; i++) {
            String odd = con(s, i, i, n);
            if (odd.length() > ans.length()) {
                ans = odd;
            }

            String even = con(s, i, i + 1, n);
            if (even.length() > ans.length()) {
                ans = even;
            }
        }

        return ans;
    }
}
