import java.util.*;
public class Main
{
    static int mul(int target,int[] arr)
    {
       for(int i=0;i<arr.length;i++)
       {
           if(arr[i]==target)
            return i;
       }
       return -1;
       
    }
    public static void main(String[] args)
    {
        int arr[]={1,2,3,4,5};
        int n=arr.length;
        int target=5;
        int ans=mul(target,arr);
        System.out.print(ans);
    }
}
