import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[]={1, 2, 3, 4};
        int[] n=new int[arr.length];
        n[0]=arr[0];
        int l=0;
        for( int i=1;i<arr.length;i++)
        {
           n[i]=n[l]+arr[i];
           l++;
        }
        System.out.print(Arrays.toString(n));
    }
}
