import java.util.*;

public class Main {
    public static void main(String[] args) {
        int[] arr1 = {1, 2, 3};
        int[] arr2 = {1,4, 5, 6,3,7,8};
        int[] merged = new int[arr1.length + arr2.length];
        int index = 0;
        for (int i = 0; i < arr1.length; i++) {
            merged[index++] = arr1[i];
        }
        for (int i = 0; i < arr2.length; i++) {
            merged[index++] = arr2[i];
        }
        
        HashSet<Integer> s=new HashSet<>();
        for(int i:merged )
        {
            s.add(i);
        }
         System.out.print(s);
    }
}
