import java.util.*;

class Main {
    public static void main(String[] args) {
       int[] a= {1, 2, 3, 4, 4};
       int[] b= {2, 4, 5, 5};
       int[] arr=new int[a.length + b.length];
        for(int i=0;i<a.length;i++)
        {
            arr[i]=a[i];
        }
        int l=0;
        for(int i=a.length;i<arr.length;i++)
        {
            arr[i]=b[l];
            l++;
        }
        Arrays.sort(arr);
        System.out.print(Arrays.toString(arr));

    }
}
