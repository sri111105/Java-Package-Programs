import java.util.*;
public class Main
{
    static int mul(int max,int[] arr)
    {
       for(int i:arr)
       {
           if(i>max)
           {
               max=i;
           }
       }
        return max;
    }
    public static void main(String[] args)
    {
        int arr[]={1,2,3,4,5};
        int max=arr[0];
        int ans=mul(max,arr);
        System.out.print(ans);
    }
}
