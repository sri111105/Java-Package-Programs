import java.util.*;
class Main {
    public static void main(String[] args) {
        int arr[]={1,2,3,4,5,6,7};
        int[] ans= new int[arr.length];
       int left=0;
       int right=arr.length-1;
       int index=0;
       while(left<=right)
       {
           if(left==right)
           {
               ans[index]=arr[left];
               index++;
           }
           else
           {
               ans[index++]=arr[left];
               ans[index++]=arr[right];
           }
           left++;
           right--;
       }
       System.out.print(Arrays.toString(ans));
    }
}
