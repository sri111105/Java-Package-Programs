class Solution {
    public int pivotIndex(int[] nums) {
          int n=nums.length;
          int lsu[]=new int[n];
          int rsu[]=new int[n];
          lsu[0]=nums[0];
          for(int i=1;i<n;i++)
          {
            lsu[i]=lsu[i-1]+nums[i];
          }
          rsu[n-1]=nums[n-1];
          for(int i=n-2;i>=0;i--)
          {
            rsu[i]=rsu[i+1]+nums[i];
          }
          for(int i=0;i<n;i++)
          {
            if(lsu[i]==rsu[i])
            {
            return i;
            }
          }
        return -1;
    }
}
